# ESP-IDF build trees. One per role, each ~135 MB - all regenerated by
# `idf.py -B <dir> build`.
build/
build_a/
build_b1/
build_b2/
build_diag/
build_i2cdiag/
build_host/

# Generated from sdkconfig.defaults on the first build. The per-role variants
# are machine-local: they carry the serial port and flash settings of whichever
# Mac produced them.
sdkconfig
sdkconfig.old
sdkconfig.a
sdkconfig.b1
sdkconfig.b1.old
sdkconfig.b2
sdkconfig.diag
sdkconfig.i2cdiag

# Pulled by the ESP-IDF component manager from dependencies.lock.
managed_components/

# Third-party, cloned by hand - see README. Upstream is nopnop2002/esp-idf-sx126x
# (MIT); vendoring the whole tree here would bury a second git repo inside this one.
external/

# API 인증키. public 저장소이므로 절대 커밋하지 않는다.
Key
*.key
.env

compile_commands.json
__pycache__/
.DS_Store

# Local UI state: the captured tank baselines are measurements of one physical
# rig and mean nothing anywhere else.
tools/ui/ui_state.json
